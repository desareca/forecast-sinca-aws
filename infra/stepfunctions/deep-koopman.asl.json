            "Choices": [
              {
                "Variable": "$.marcador.existe",
                "BooleanEquals": true,
                "Next": "TestSaltar"
              }
            ],
            "Default": "TestJob"
          },
          "TestSaltar": {
            "Type": "Pass",
            "Parameters": {
              "clave.$": "$.item.clave",
              "estado": "saltado"
            },
            "End": true
          },
          "TestJob": {
            "Type": "Task",
            "Resource": "arn:aws:states:::sagemaker:createTrainingJob.sync",
            "Parameters": {
              "TrainingJobName.$": "$.item.nombre",
              "AlgorithmSpecification": {
                "TrainingImage.$": "$.comun.imagen",
                "TrainingInputMode": "File"
              },
              "RoleArn.$": "$.comun.rol",
              "HyperParameters.$": "$.item.hp",
              "ResourceConfig": {
                "InstanceCount": 1,
                "InstanceType.$": "$.comun.instancia",
                "VolumeSizeInGB": 30
              },
              "StoppingCondition": {
                "MaxRuntimeInSeconds.$": "$.item.max_run"
              },
              "OutputDataConfig": {
                "S3OutputPath.$": "$.comun.salida"
              },
              "CheckpointConfig": {
                "S3Uri.$": "$.item.ckpt_uri",
                "LocalPath": "/opt/ml/checkpoints"
              },
              "Tags": [
                {
                  "Key": "proyecto",
                  "Value": "sinca"
                },
                {
                  "Key": "campana",
                  "Value.$": "$.campana"
                }
              ]
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "SageMaker.AmazonSageMakerException",
                  "SageMaker.ResourceLimitExceededException"
                ],
                "IntervalSeconds": 300,
                "MaxAttempts": 2,
                "BackoffRate": 2
              }
            ],
            "ResultPath": null,
            "Next": "TestLanzado"
          },
          "TestLanzado": {
            "Type": "Pass",
            "Parameters": {
              "clave.$": "$.item.clave",
              "estado": "lanzado"
            },
            "End": true
          }
        }
      },
      "ResultPath": "$.res_test",
      "Next": "ResumenTest"
    },
    "ResumenTest": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${lambda_arn}",
        "Payload": {
          "modo": "resumen",
          "bucket.$": "$.comun.bucket",
          "key.$": "$.resumenes.test"
        }
      },
      "ResultSelector": {
        "texto.$": "$.Payload.texto"
      },
      "ResultPath": "$.txt_test",
      "Next": "AvisoFinal"
    },
    "AvisoFinal": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${topic_arn}",
        "Subject": "deep-koopman: test terminado",
        "Message.$": "States.Format('Campaña {} terminada. {}', $.campana, $.txt_test.texto)"
      },
      "ResultPath": null,
      "Next": "Fin"
    },
    "Fin": {
      "Type": "Succeed"
    }
  }
}
