{
  "Comment": "deep-koopman: campaña fija de Training Jobs en serie (F1, B, F2, F3, selección, cierre, test) con salto por marcador y avisos; sin ramas ni pausas (D18).",
  "StartAt": "AvisoInicio",
  "States": {
    "AvisoInicio": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${topic_arn}",
        "Subject": "deep-koopman: inicio",
        "Message.$": "States.Format('Campaña {} iniciada (modo {}): F1, B, F2, F3, selección, cierre y test en serie.', $.campana, $.modo)"
      },
      "ResultPath": null,
      "Next": "F1"
    },
    "F1": {
      "Type": "Map",
      "ItemsPath": "$.fases.f1",
      "MaxConcurrency": 1,
      "ItemSelector": {
        "item.$": "$$.Map.Item.Value",
        "comun.$": "$.comun",
        "campana.$": "$.campana"
      },
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "F1Marcador",
        "States": {
          "F1Marcador": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${lambda_arn}",
              "Payload": {
                "modo": "estado_job",
                "bucket.$": "$.comun.bucket",
                "key.$": "$.item.marcador"
              }
            },
            "ResultSelector": {
              "existe.$": "$.Payload.existe"
            },
            "ResultPath": "$.marcador",
            "Next": "F1Hecho"
          },
          "F1Hecho": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.marcador.existe",
                "BooleanEquals": true,
                "Next": "F1Saltar"
              }
            ],
            "Default": "F1Job"
          },
          "F1Saltar": {
            "Type": "Pass",
            "Parameters": {
              "clave.$": "$.item.clave",
              "estado": "saltado"
            },
            "End": true
          },
          "F1Job": {
            "Type": "Task",
            "Resource": "arn:aws:states:::sagemaker:createTrainingJob.sync",
            "Parameters": {
              "TrainingJobName.$": "$.item.nombre",
              "AlgorithmSpecification": {
                "TrainingImage.$": "$.comun.imagen",
                "TrainingInputMode": "File"
              },
              "RoleArn.$": "$.comun.rol",
              "HyperParameters.$": "$.item.hp",
              "ResourceConfig": {
                "InstanceCount": 1,
                "InstanceType.$": "$.comun.instancia",
                "VolumeSizeInGB": 30
              },
              "StoppingCondition": {
                "MaxRuntimeInSeconds.$": "$.item.max_run"
              },
              "OutputDataConfig": {
                "S3OutputPath.$": "$.comun.salida"
              },
              "CheckpointConfig": {
                "S3Uri.$": "$.item.ckpt_uri",
                "LocalPath": "/opt/ml/checkpoints"
              },
              "Tags": [
                {
                  "Key": "proyecto",
                  "Value": "sinca"
                },
                {
                  "Key": "campana",
                  "Value.$": "$.campana"
                }
              ]
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "SageMaker.AmazonSageMakerException",
                  "SageMaker.ResourceLimitExceededException"
                ],
                "IntervalSeconds": 300,
                "MaxAttempts": 2,
                "BackoffRate": 2
              }
            ],
            "ResultPath": null,
            "Next": "F1Lanzado"
          },
          "F1Lanzado": {
            "Type": "Pass",
            "Parameters": {
              "clave.$": "$.item.clave",
              "estado": "lanzado"
            },
            "End": true
          }
        }
      },
      "ResultPath": "$.res_f1",
      "Next": "AvisoF1"
    },
    "AvisoF1": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
