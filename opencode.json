{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "implementador",
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git status*", "effect": "allow" },
    { "action": "shell", "resource": "git diff*", "effect": "allow" },
    { "action": "shell", "resource": "git log*", "effect": "allow" },
    { "action": "shell", "resource": "git add*", "effect": "allow" },
    { "action": "shell", "resource": "git commit*", "effect": "allow" },
    { "action": "shell", "resource": "git remote*", "effect": "allow" },
    { "action": "shell", "resource": "git branch*", "effect": "allow" },
    { "action": "shell", "resource": "terraform init*", "effect": "allow" },
    { "action": "shell", "resource": "terraform validate*", "effect": "allow" },
    { "action": "shell", "resource": "terraform plan*", "effect": "allow" },
    { "action": "shell", "resource": "terraform fmt*", "effect": "allow" },
    { "action": "shell", "resource": "docker build*", "effect": "allow" },
    { "action": "shell", "resource": "docker images*", "effect": "allow" },
    { "action": "shell", "resource": "docker ps*", "effect": "allow" },
    { "action": "shell", "resource": "aws sts get-caller-identity*", "effect": "allow" },
    { "action": "shell", "resource": "aws ec2 describe-*", "effect": "allow" },
    { "action": "shell", "resource": "aws ec2 list-*", "effect": "allow" },
    { "action": "shell", "resource": "aws ecr describe-*", "effect": "allow" },
    { "action": "shell", "resource": "aws ecr list-*", "effect": "allow" },
    { "action": "shell", "resource": "aws s3 ls*", "effect": "allow" },
    { "action": "shell", "resource": "aws s3api get-*", "effect": "allow" },
    { "action": "shell", "resource": "aws s3api list-*", "effect": "allow" },
    { "action": "shell", "resource": "aws secretsmanager describe-secret*", "effect": "allow" },
    { "action": "shell", "resource": "aws secretsmanager list-secrets*", "effect": "allow" },
    { "action": "shell", "resource": "aws logs describe-*", "effect": "allow" },
    { "action": "shell", "resource": "aws logs tail*", "effect": "allow" },
    { "action": "shell", "resource": "aws logs get-log-events*", "effect": "allow" },
    { "action": "shell", "resource": "aws iam get-*", "effect": "allow" },
    { "action": "shell", "resource": "aws iam list-*", "effect": "allow" },
    { "action": "shell", "resource": "aws lambda get-*", "effect": "allow" },
    { "action": "shell", "resource": "aws lambda list-*", "effect": "allow" },
    { "action": "shell", "resource": "aws sagemaker describe-*", "effect": "allow" },
    { "action": "shell", "resource": "aws sagemaker list-*", "effect": "allow" },
    { "action": "shell", "resource": "aws sagemaker get-*", "effect": "allow" },
    { "action": "shell", "resource": "aws sns list-*", "effect": "allow" },
    { "action": "shell", "resource": "aws sns get-*", "effect": "allow" },
    { "action": "shell", "resource": "aws events list-*", "effect": "allow" },
    { "action": "shell", "resource": "aws events describe-*", "effect": "allow" },
    { "action": "shell", "resource": "aws scheduler get-*", "effect": "allow" },
    { "action": "shell", "resource": "aws scheduler list-*", "effect": "allow" },
    { "action": "shell", "resource": "aws ssm start-session*", "effect": "allow" },
    { "action": "shell", "resource": "ssh *", "effect": "allow" },
    { "action": "shell", "resource": "openspec status*", "effect": "allow" },
    { "action": "shell", "resource": "openspec list*", "effect": "allow" },
    { "action": "shell", "resource": "openspec validate*", "effect": "allow" },
    { "action": "shell", "resource": "openspec show*", "effect": "allow" },
    { "action": "shell", "resource": "terraform apply*", "effect": "deny" },
    { "action": "shell", "resource": "terraform destroy*", "effect": "deny" },
    { "action": "shell", "resource": "aws * delete*", "effect": "deny" },
    { "action": "shell", "resource": "aws * rm*", "effect": "deny" },
    { "action": "shell", "resource": "aws s3 rm*", "effect": "deny" },
    { "action": "shell", "resource": "git push --force*", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "deny" }
  ],
  "agents": {
    "arquitecto": {
      "system": "Arquitecto — piensa, explora, redacta proposal/design/tasks.md via /opsx/propose. No implementa codigo.",
      "model": "opencode/deepseek-v4-pro",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "ask" },
        { "action": "shell", "resource": "*", "effect": "ask" }
      ]
    },
    "implementador": {
      "system": "Implementador — ejecuta tareas de tasks.md via /opsx/apply, cierra changes via /opsx/archive. No redacta arquitectura.",
      "model": "opencode/deepseek-v4.1-flash",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "allow" }
      ]
    }
  }
}
