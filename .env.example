# Variables de entorno del pipeline de datos (pipeline/).
# Copiar a `.env` (gitignored) y completar a mano. NUNCA commitear `.env` con
# valores reales.
#
# El entrypoint carga este archivo automáticamente en corridas locales
# (`load_dotenv`, sin sobreescribir variables ya seteadas). En Fargate no hay
# `.env`: las variables las setea la task definition.

# --- AWS (obligatorio fuera de Fargate) --------------------------------------
# Named profile de la cuenta personal. NUNCA `default` ni un profile ajeno.
AWS_PROFILE=<aws-profile>
AWS_DEFAULT_REGION=us-east-1

# --- Pipeline (opcionales; tienen default en el código) ----------------------
# Bucket S3 de datos (default: sinca-data).
DATA_BUCKET=sinca-data
# Umbral de cuarentena por estación, 0-1 (default: 0.2). Si una estación lo
# supera, no se persiste `validated` para esa estación.
MAX_QUARANTINE_RATE=0.2
# Nivel de logging: DEBUG, INFO, WARNING, ERROR (default: INFO).
LOG_LEVEL=INFO
